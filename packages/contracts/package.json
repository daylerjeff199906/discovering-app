{
  "name": "@por-aqui/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contratos Zod compartidos (browser-safe): entradas, salidas, enums y errores de la API.",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch src",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@por-aqui/config-eslint": "workspace:*",
    "@por-aqui/config-typescript": "workspace:*",
    "eslint": "10.13.0",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
