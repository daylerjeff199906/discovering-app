{
  "name": "@por-aqui/api",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS (monolito modular) y worker de Por aquí.",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"nodemon --legacy-watch --delay 1.5 --watch dist --ext js --exec \\\"node dist/main.js\\\"\" \"nodemon --legacy-watch --delay 1.5 --watch dist --ext js --exec \\\"node dist/worker.js\\\"\"",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-presigned-post": "3.1149.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@por-aqui/contracts": "workspace:*",
    "@por-aqui/database": "workspace:*",
    "argon2": "0.45.1",
    "bullmq": "6.3.12",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@por-aqui/config-eslint": "workspace:*",
    "@por-aqui/config-typescript": "workspace:*",
    "@swc/core": "1.16.18",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "9.2.1",
    "eslint": "10.13.0",
    "nodemon": "3.1.14",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
