# ───────────────────────────────────────────────────────────────
# Por aquí — variables de entorno (SIN secretos reales).
# Copia a .env:   cp .env.example .env
# Todo lo que empiece con VITE_ es PÚBLICO (viaja al navegador).
# ───────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=development            # development | demo | production

# ── Infraestructura (compose.yaml) ─────────────────────────────
POSTGRES_USER=poraqui
POSTGRES_PASSWORD=poraqui_dev_password
POSTGRES_DB=poraqui
POSTGRES_PORT=5440
REDIS_PORT=6380

# ── API (apps/api) ─────────────────────────────────────────────
API_PORT=4000
DATABASE_URL=postgres://poraqui:poraqui_dev_password@localhost:5440/poraqui
REDIS_URL=redis://localhost:6380
WEB_ORIGIN=http://localhost:5173
# Orígenes permitidos para CORS y validación de Origin (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false            # true en producción (HTTPS)
SESSION_COOKIE_NAME=pa_session
CSRF_COOKIE_NAME=pa_csrf
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_IDLE_TTL_DAYS=7
# Clave para cifrar payloads sensibles temporales (32 bytes en base64). Genera una propia.
APP_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1rZXktZm9yLXBvcmFxdWk=

# ── Cloudflare R2 (archivos: avatares, fotos de lugares…) ─────
# Bucket PRIVADO. Pega aquí las claves (ver docs/SETUP.md → «Cloudflare R2»).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Opcional; por defecto https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
UPLOAD_URL_TTL_SECONDS=300
MEDIA_URL_TTL_SECONDS=120
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_PIXELS=60000000
MEDIA_MAX_PER_VISIT=20

# ── Importar recorridos (GPX, KML, Takeout de Google) ──────────
IMPORT_MAX_BYTES=10485760
IMPORT_MAX_POINTS=50000
IMPORT_MAX_WAYPOINTS=1000

# ── Resend (correo transaccional) ──────────────────────────────
# Sin RESEND_API_KEY (solo en desarrollo) los correos se guardan como archivo en DEV_MAIL_DIR.
RESEND_API_KEY=
MAIL_FROM="Por aquí <onboarding@resend.dev>"
MAIL_REPLY_TO=
DEV_MAIL_DIR=.dev-mail

# Proveedores geográficos. none = sin proveedor (degradación explícita).
#   ROUTING_PROVIDER: none | osrm | fixture(solo test/demo)
ROUTING_PROVIDER=none
OSRM_BASE_URL=
#   GEOCODER_PROVIDER: none | nominatim
GEOCODER_PROVIDER=none
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT="PorAqui/0.1 (contacto@example.com)"

# Contenido de demostración (seeds). Nunca en producción.
ENABLE_DEMO_CONTENT=true

# ── Web (apps/web) ─────────────────────────────────────────────
WEB_PORT=5173
# URL interna para SSR → API (no se expone al navegador)
API_INTERNAL_URL=http://localhost:4000
PUBLIC_SITE_URL=http://localhost:5173
# Públicas (VITE_*)
VITE_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION="© OpenStreetMap contributors"
VITE_DEMO_BANNER=true

# ── Google (iniciar sesión / crear cuenta + foto de perfil) ───────────
# Opcional. Sin estas dos claves el botón «Continuar con Google» no aparece.
# Google Cloud Console → APIs y servicios → Credenciales → ID de cliente OAuth (Aplicación web).
# URI de redireccionamiento autorizado:  <PUBLIC_SITE_URL>/api/v1/auth/google/callback
#   p. ej. http://localhost:5173/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   (solo si el callback público es distinto del anterior)
